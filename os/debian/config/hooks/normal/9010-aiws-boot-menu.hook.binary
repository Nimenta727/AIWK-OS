#!/bin/sh
# Runs in the live-build binary stage (cwd = binary tree). Makes the boot menu auto-continue and request
# a 1080p console instead of waiting forever at a 640x480 menu. Never fails the build: a missing file is skipped.
#
# live-build (trixie, 20250505) ships:
#   isolinux/isolinux.cfg   "timeout 0"            (BIOS; syslinux: 0 = wait forever)  -> rewritten to 3 s
#   boot/grub/config.cfg    no "set timeout" at all (UEFI; GRUB: unset = wait forever) -> one line ADDED
# The GRUB case is why the UEFI firmware boot test never reached the kernel: rewriting a line that does not
# exist changes nothing. The test os/verify/test_boot_menu_hook.py runs this hook on those exact templates.
set -eu
for f in isolinux/*.cfg; do
  [ -f "$f" ] || continue
  sed -i -E 's/^([[:space:]]*)timeout[[:space:]]+[0-9]+/\1timeout 30/I' "$f"
done
for f in boot/grub/*.cfg; do
  [ -f "$f" ] || continue
  sed -i -E 's/^([[:space:]]*)set timeout=[0-9]+/\1set timeout=3/' "$f"
done
# config.cfg is sourced by grub.cfg before the menu entries, so a timeout set there governs the menu.
cfg=boot/grub/config.cfg
if [ -f "$cfg" ] && ! grep -qE '^[[:space:]]*set[[:space:]]+timeout=' "$cfg"; then
  printf '\n# AIWS: boot the default entry after 3 s instead of waiting forever\nset timeout=3\nset timeout_style=menu\n' >> "$cfg"
fi
