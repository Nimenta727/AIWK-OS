# Changing this file on a branch that carries .github/workflows/release-preview.yml starts the preview-release build.
#   AIWS_RELEASE_STAGE=code      build AIWS Code and llama-server only (fast feedback on the least-tested parts)
#   AIWS_RELEASE_STAGE=iso-dry   also build the full ISO and boot it in QEMU, but publish nothing
#   AIWS_RELEASE_STAGE=full      also publish a GitHub PRE-RELEASE (only if every step above passed)
AIWS_RELEASE_STAGE=full
AIWS_RELEASE_TAG=v0.3.0-preview.1
AIWS_RELEASE_TITLE="AIWK-OS 0.3.0-preview.1 (test build, Qwen3.5-9B)"
# attempt 8: output dir owned by the runner after the root container build; serial log in RUNNER_TEMP
# attempt 9 (0.3.0): 9B model + local assistant; new tag because v0.2.0-preview.1 already exists
# attempt 10: install python3 in the build container (build.sh uses it for the skill, plugin and system manifests)
# attempt 11: release without model weights (customers download them: docs/AIWS_MODEL_WEIGHTS.md)
# attempt 12: release notes cleaned (no QWEN-LICENSE attachment, no 9-10 GB claim)
