#!/bin/sh
# AIWS Shell: activate the user service, then open a normal native app window.
set -eu
if [ "$(id -u)" -eq 0 ]; then exit 1; fi
# The read-only bundled GGUF is verified and loaded in place by the model
# service when the user explicitly enables it. No multi-GB overlay copy.
systemctl --user start aiws-workbench.service || exit 1
ready=0
for i in $(seq 1 45); do
    if curl --noproxy '*' --max-time 1 --fail --silent http://127.0.0.1:17640/api/v1/health >/dev/null; then
        ready=1
        break
    fi
    sleep 1
done
if [ "$ready" -ne 1 ]; then echo 'AIWS local guest service did not start' >&2; exit 1; fi
if command -v chromium >/dev/null 2>&1; then
    exec chromium --password-store=basic --no-first-run --no-default-browser-check --disable-session-crashed-bubble --no-proxy-server --start-fullscreen --app=http://127.0.0.1:17640/
fi
if command -v firefox-esr >/dev/null 2>&1; then
    exec firefox-esr --new-window http://127.0.0.1:17640/
fi
echo 'No compatible browser installed' >&2
exit 1
