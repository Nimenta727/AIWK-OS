<Window x:Class="AIWorkstation.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Workstation · Windows" Width="1430" Height="880" MinWidth="1090" MinHeight="700"
        Background="{StaticResource Canvas}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <!-- LEFT: native Windows sidebar -->
        <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,28,18,20">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,40">
                        <Border Width="36" Height="36" Background="{StaticResource Accent}" CornerRadius="11">
                            <TextBlock Text="✦" Foreground="White" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,1,0,0">
                            <TextBlock Text="atelier" FontSize="21" FontWeight="SemiBold" FontFamily="Georgia"/>
                            <TextBlock Text="AI WORKSTATION" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="工作空间" Style="{StaticResource SectionLabel}" Margin="12,0,0,12"/>
                    <Button x:Name="NavHome" Click="HomeNav_Click" Style="{StaticResource NavButton}" Content="⌂   工作台概览"/>
                    <Button x:Name="NavFlow" Click="FlowNav_Click" Style="{StaticResource NavButton}" Content="◇   可视化工作流"/>
                    <Button x:Name="NavTrace" Click="TraceNav_Click" Style="{StaticResource NavButton}" Content="◷   请求追踪 / Token"/>
                    <Button x:Name="NavTools" Click="ToolsNav_Click" Style="{StaticResource NavButton}" Content="⊞   Agent 与集成"/>
                    <Border Background="{StaticResource Edge}" Height="1" Margin="12,24,12,23"/>
                    <TextBlock Text="最近项目" Style="{StaticResource SectionLabel}" Margin="12,0,0,12"/>
                    <ListBox x:Name="TasksList" SelectionChanged="TasksList_SelectionChanged"
                             BorderThickness="0" Background="Transparent" Height="325"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,10" Margin="0,2" Background="Transparent" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Margin="8,0,8,18"/>
                    <Border Background="#EDE8E1" CornerRadius="12" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Good}" VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="运行于本机" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Hyper-V Windows Guest" FontSize="10" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- MAIN: dashboard and interactive workflow canvas -->
        <Grid Grid.Column="1" Margin="38,29,36,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="YOUR PRIVATE AI DESK" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="TopHeading" Text="工作台概览" FontSize="29" FontFamily="Georgia" Margin="0,7,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="16" Background="White" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="12,8" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Good}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Windows Native · v0.6" Foreground="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="1">
                <!-- HOME -->
                <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#F4E8DE" CornerRadius="18" Padding="28,27" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="把想法交给合适的 Agent。" FontSize="27" FontFamily="Georgia" Foreground="#4C3A32"/>
                                <TextBlock Text="在同一个 Windows 工作台中规划、执行与审查。让 Claude 和 Codex 协作，不必切换多个窗口管理任务。" TextWrapping="Wrap" FontSize="13" Foreground="#826B5B" Margin="0,10,0,24"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="9" Height="9" Background="{StaticResource Accent}" CornerRadius="5" Margin="0,5,8,0"/>
                                    <TextBlock Text="每个阶段都可见、可审批、可追踪" FontWeight="SemiBold" Foreground="#7E5749"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="开始一个新任务" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,14"/>
                        <Border Background="White" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="15" Padding="22">
                            <StackPanel>
                                <TextBlock Text="任务名称" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="NewTaskTitle" Text="为我的项目构建功能"/>
                                <TextBlock Text="Windows 工作目录" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewTaskWorkspace" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource SoftButton}" Margin="9,0,0,0" Content="选择文件夹" Click="PickFolder_Click"/>
                                </Grid>
                                <TextBlock Text="流程模板" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="NewTaskTemplate" SelectedIndex="0">
                                    <ComboBoxItem Content="Claude → Codex → Claude · 编程协作"/>
                                    <ComboBoxItem Content="Claude → Codex → 人工 · 研究协作"/>
                                </ComboBox>
                                <Button Content="创建可视化工作流   ↗" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" HorizontalAlignment="Left" Click="CreateTask_Click"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="为什么重新设计" FontSize="17" FontWeight="SemiBold" Margin="0,26,0,12"/>
                        <UniformGrid Columns="2">
                            <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="0,0,8,0" Padding="17">
                                <StackPanel><TextBlock Text="◇  可视化执行" FontWeight="SemiBold"/><TextBlock Text="任务步骤、审批与交接进度一目了然。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="8,0,0,0" Padding="17">
                                <StackPanel><TextBlock Text="⊞  原生 Windows" FontWeight="SemiBold"/><TextBlock Text="独立 EXE、系统目录与官方 CLI 集成。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
                <!-- VISUAL WORKFLOW -->
                <Grid x:Name="FlowView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="14" Padding="17" Margin="0,0,0,18">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ActiveTaskTitle" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ActiveTaskPath" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource SoftAccent}" CornerRadius="10" Padding="12,7" VerticalAlignment="Center">
                                <TextBlock x:Name="ProgressText" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="11"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="EXECUTION CANVAS" Style="{StaticResource SectionLabel}" Margin="0,1,0,16"/>
                            <ItemsControl x:Name="StepsCanvas">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Stretch">
                                            <Button Click="SelectStep_Click" Tag="{Binding Id}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0" Cursor="Hand">
                                                <Border Background="White" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="15" Padding="18">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Border Width="35" Height="35" Background="{StaticResource SoftAccent}" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Number}" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Agent}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="#F6F2EC" CornerRadius="9" Padding="11,7" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Accent}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,0">
                                                <Border Height="19" Width="1" Background="#D9CEC4"/>
                                                <TextBlock Text="↓" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,-4,0,1"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Click="AddStep_Click" Style="{StaticResource SoftButton}" Content="＋  添加流程阶段" HorizontalAlignment="Stretch" Margin="0,8,0,35"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <!-- CALL FLOW: each card is derived from local evidence or explicitly imported usage. -->
                <ScrollViewer x:Name="TraceView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="看得见的 AI 调用链。" FontFamily="Georgia" FontSize="26" Foreground="{StaticResource Ink}" Margin="0,0,0,8"/>
                        <TextBlock Text="从任务分配到交接结果，点击任意节点查看证据。橙色是本地记录，绿色是用户导入的用量；未观察到的模型请求始终标为未知。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,17"/>
                        <Border Background="#F4E8DE" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="REQUEST FLOW  /  任务链路" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="TraceChainSummary" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,5" TextWrapping="Wrap"/>
                                <TextBlock Text="每一行是一段执行阶段；箭头表示计划中的依赖关系，并不自动代表真实模型调用。" FontSize="11" Foreground="#876A59" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                    <Button Content="↻  刷新节点状态" Click="RefreshTrace_Click" Style="{StaticResource SoftButton}" Margin="0,0,9,0"/>
                                    <Button Content="导出脱敏链路 JSON" Click="ExportTrace_Click" Style="{StaticResource SoftButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="16" Padding="19" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="导入的 Token 用量（未验证来源）" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="UsageSummary" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,6"/>
                                <TextBlock x:Name="UsageDetail" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TraceQualitySummary" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,3"/>
                                <Button Content="为当前阶段导入官方用量日志" Style="{StaticResource SoftButton}" Click="ImportTrace_Click" Margin="0,13,0,0" HorizontalAlignment="Left"/>
                                <TextBlock Text="导入需由你主动选择日志；不会读取登录凭据、扫描 CLI 会话目录或自动转发聊天内容。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="可交互执行链路" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,7"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                            <TextBlock Text="● 已记录的本地动作" Foreground="#A56648" FontSize="11" Margin="0,0,15,0"/>
                            <TextBlock Text="● 用户导入统计" Foreground="#3C8068" FontSize="11" Margin="0,0,15,0"/>
                            <TextBlock Text="● 未观察 / 计划" Foreground="#85817D" FontSize="11"/>
                        </StackPanel>
                        <ItemsControl x:Name="TraceFlowLanes">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Edge}" BorderThickness="1" Background="White" CornerRadius="15" Padding="14,13,14,15" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid Margin="2,0,2,12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Agent}" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding State}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,5">
                                                <ItemsControl ItemsSource="{Binding Nodes}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Style="{StaticResource TraceNodeButton}" Click="TraceNode_Click" Tag="{Binding Id}" ToolTip="点击查看这个节点的证据与统计">
                                                                    <Border Width="166" Height="135" CornerRadius="12" Padding="12" Background="{Binding Surface}" BorderBrush="{Binding Stroke}" BorderThickness="1.5">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding PhaseLabel}" Foreground="{Binding LabelBrush}" FontWeight="SemiBold" FontSize="10"/>
                                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding StateLabel}" Foreground="{Binding LabelBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Button>
                                                                <TextBlock Text="→" Foreground="#C3B6A9" VerticalAlignment="Center" FontSize="19" Margin="6,0" Visibility="{Binding ArrowVisibility}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <StackPanel Visibility="{Binding ImportedVisibility}" Margin="0,10,0,0">
                                                <TextBlock Text="用户导入的回合和工具事件（仅元数据 · 非实时监听）" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                                                <ScrollViewer MaxHeight="116" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding ImportedEvents}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#EFF7F1" BorderBrush="#DBE9DF" BorderThickness="1" CornerRadius="9" Padding="9,7" Margin="0,0,7,6">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Title}" Foreground="#34765B" FontSize="10" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{Binding Metric}" Foreground="#5A7465" FontSize="10" Margin="0,3,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="{StaticResource SoftAccent}" CornerRadius="13" Padding="17" Margin="0,5,0,16">
                            <StackPanel>
                                <TextBlock Text="发送前的上下文优化" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ContextSummary" Foreground="#826B5B" FontSize="12" Margin="0,8,0,10" TextWrapping="Wrap"/>
                                <Button Content="预览交接指令（本地操作，不发送）" Click="PreviewPrompt_Click" Style="{StaticResource SoftButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="本地事件时间线" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,11"/>
                        <ItemsControl x:Name="TraceEventsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,7" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="交接请求本地预览 · 从未自动发送" FontWeight="SemiBold" FontSize="14" Margin="0,18,0,10"/>
                        <TextBox x:Name="PromptPreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="190" VerticalScrollBarVisibility="Auto" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
                <!-- INTEGRATIONS -->
                <ScrollViewer x:Name="ToolsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="已连接的能力" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="使用你自己安装并登录的官方工具。登录凭据不会被读取或复制。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,22"/>
                        <Border Background="White" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="14" Padding="21" Margin="0,0,0,14">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Claude Code" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ClaudeHealth" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SoftButton}" Content="定位状态" Click="RefreshTools_Click"/>
                            </Grid>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="14" Padding="21" Margin="0,0,0,14">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Codex CLI" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="CodexHealth" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SoftButton}" Content="定位状态" Click="RefreshTools_Click"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="成熟平台 · 可选集成" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,14"/>
                        <Border Background="White" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,13">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="T3 Code" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="成熟多 Agent 编程控制台 · 独立启动" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
                                <Button Grid.Column="1" Content="启动 T3 ↗" Click="LaunchT3_Click" Style="{StaticResource SoftButton}"/>
                            </Grid>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="14" Padding="20">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="OpenClaw" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Windows 节点和通用 Agent 功能 · 独立部署" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
                                <Button Grid.Column="1" Content="启动 CLI ↗" Click="LaunchOpenClaw_Click" Style="{StaticResource SoftButton}"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource SoftAccent}" CornerRadius="12" Padding="16" Margin="0,24,0,0">
                            <TextBlock Text="工作台不会伪装订阅 API，也不会将第三方账号令牌作为模型接口。所有启动操作均由用户点击触发。" TextWrapping="Wrap" Foreground="#8A5844" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <TextBlock Grid.Row="2" x:Name="StatusLine" Text="就绪 · 本机数据保存在用户目录" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"/>
        </Grid>
        <!-- RIGHT: inspector -->
        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Edge}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                <StackPanel x:Name="StepInspectorPanel" Margin="24,34,24,30">
                    <TextBlock Text="INSPECTOR" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="阶段设置" FontFamily="Georgia" FontSize="24" Margin="0,12,0,7"/>
                    <TextBlock Text="编辑流程节点、设置审批，再从这里启动官方 Agent。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,25"/>
                    <Border Height="1" Background="{StaticResource Edge}" Margin="0,0,0,12"/>
                    <TextBlock Text="阶段名称" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="StepTitleBox"/>
                    <TextBlock Text="执行器" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="StepAgentCombo" SelectedIndex="0"><ComboBoxItem Content="Claude Code"/><ComboBoxItem Content="Codex CLI"/><ComboBoxItem Content="人工 / 审查"/></ComboBox>
                    <CheckBox x:Name="NeedsApprovalCheck" Content="执行前需要显式审批" Margin="0,15,0,10" Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="阶段指令" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="StepInstructionsBox" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Height="102" VerticalScrollBarVisibility="Auto"/>
                    <Button Content="保存节点修改" Click="SaveStep_Click" Style="{StaticResource SoftButton}" HorizontalAlignment="Stretch" Margin="0,8,0,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="↑ 上移" Click="MoveUp_Click" Style="{StaticResource SoftButton}" Padding="12,9" Margin="0,0,5,0"/>
                        <Button Content="↓ 下移" Click="MoveDown_Click" Style="{StaticResource SoftButton}" Padding="12,9" Margin="5,0,0,0"/>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Edge}" Margin="0,22,0,14"/>
                    <TextBlock Text="执行与交接" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="点击复制当前阶段指令，并打开已登录的官方 CLI。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,12"/>
                    <Button Content="复制阶段交接指令" Click="CopyPrompt_Click" Style="{StaticResource SoftButton}" Margin="0,0,0,9"/>
                    <Button Content="批准当前阶段" Click="ApproveStep_Click" Style="{StaticResource SoftButton}" Margin="0,0,0,9"/>
                    <Button Content="开始并启动 Agent ↗" Click="StartAgent_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,0,16"/>
                    <TextBlock Text="执行结果 / 审查意见" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="StepResultBox" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Height="104"/>
                    <Button Content="标记阶段完成 ✓" Click="CompleteStep_Click" Style="{StaticResource SoftButton}" Margin="0,8,0,8"/>
                    <Button Content="标记失败 / 重置" Click="FailOrRetryStep_Click" Style="{StaticResource SoftButton}" Margin="0,0,0,10"/>
                    <TextBlock Text="注意：流程跟踪为原生实现；CLI 在独立终端中执行，结果需要人工核实与回填。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
                <StackPanel x:Name="TraceInspectorPanel" Visibility="Collapsed" Margin="24,34,24,30">
                    <TextBlock Text="CALL INSPECTOR" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="请求节点详情" FontFamily="Georgia" FontSize="24" Margin="0,12,0,8"/>
                    <TextBlock Text="这里区分计划、本地操作和真实的官方用量。点击左侧流程图里的任意节点。" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,22"/>
                    <Border Background="{StaticResource SoftAccent}" CornerRadius="13" Padding="15" Margin="0,0,0,13">
                        <StackPanel>
                            <TextBlock x:Name="TraceNodeName" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TraceNodeState" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="节点作用" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TraceNodeDescription" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,14"/>
                    <Border Height="1" Background="{StaticResource Edge}"/>
                    <TextBlock Text="证据来源" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TraceNodeEvidence" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,14"/>
                    <TextBlock Text="Token / 使用量" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TraceNodeTokens" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,14"/>
                    <TextBlock Text="时间与耗时" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TraceNodeTiming" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,14"/>
                    <Border Background="#F5F2ED" CornerRadius="12" Padding="14" Margin="0,14,0,10">
                        <StackPanel>
                            <TextBlock Text="透明度原则" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="已启动 CLI ≠ 模型成功接收请求。没有官方结构化记录就不估算真实消耗，也不会将“未知”显示为 0。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button Content="打开此阶段的工作流设置" Click="TraceToStep_Click" Style="{StaticResource SoftButton}" Margin="0,9,0,0"/>
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
