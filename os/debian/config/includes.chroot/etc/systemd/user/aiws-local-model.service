[Unit]
Description=Optional AIWS guest-local offline inference service
After=default.target
[Service]
Type=simple
ExecStart=/usr/local/bin/aiws-local-model
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077
[Install]
WantedBy=default.target
# Not enabled in image; only a guest workbench user action enables this unit.
