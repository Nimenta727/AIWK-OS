[Unit]
Description=AIWS OS user workbench and read-only Agent controller
After=graphical-session.target aiws-agent.service
Requires=aiws-agent.service
[Service]
Type=simple
ExecStart=/usr/local/bin/aiws-workbench
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
# PrivateTmp hides the X11 socket; bind it back ("-" = ignore if absent) so approved desktop launches can open windows.
BindPaths=-/tmp/.X11-unix
UMask=0077
[Install]
WantedBy=default.target
