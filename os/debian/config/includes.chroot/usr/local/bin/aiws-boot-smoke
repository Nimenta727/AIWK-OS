#!/bin/sh
# Runs only in experimental offline ISO. Emits a strict guest boot receipt to ttyS0.
set -u
emit() { printf '%s\n' "$1" > /dev/ttyS0 2>/dev/null || printf '%s\n' "$1"; }
if ! command -v lightdm >/dev/null 2>&1 ||
   ! command -v openbox >/dev/null 2>&1 ||
   ! command -v chromium >/dev/null 2>&1; then
    emit "AIWS_BOOT_SMOKE_FAIL: desktop-packages"
    exit 1
fi
desktop=0
for i in $(seq 1 65); do
    if systemctl is-active --quiet display-manager && pgrep -x openbox >/dev/null; then
        desktop=1
        break
    fi
    sleep 2
done
if [ "$desktop" -ne 1 ] || ! pgrep -x xfce4-panel >/dev/null; then
    emit "AIWS_BOOT_SMOKE_FAIL: display-manager-or-aiws-shell-not-running"
    exit 1
fi
health=0
for i in $(seq 1 35); do
    if curl --fail --silent --noproxy '*' --max-time 2 http://127.0.0.1:17640/api/v1/health |
        python3 -c 'import json,sys; d=json.load(sys.stdin); assert d["uiBundled"] and d["guestOnly"] and d["toolCount"] >= 10'; then
        health=1
        break
    fi
    sleep 2
done
if [ "$health" -ne 1 ]; then
    emit "AIWS_BOOT_SMOKE_FAIL: workbench-agent-unhealthy"
    exit 1
fi
# The independent Broker must be alive before any durable Agent tool run.
if ! runuser -u user -- env XDG_RUNTIME_DIR=/run/user/1000 \
    systemctl --user is-active --quiet aiws-permission-broker.service; then
    emit "AIWS_BOOT_SMOKE_FAIL: independent-permission-broker-unavailable"
    exit 1
fi
# The independent Agent must be a real systemd user service, not a second
# controller hidden inside the browser process.
if ! runuser -u user -- env XDG_RUNTIME_DIR=/run/user/1000 \
    systemctl --user is-active --quiet aiws-agent.service; then
    emit "AIWS_BOOT_SMOKE_FAIL: persistent-systemd-agent-not-running"
    exit 1
fi
if ! curl --fail --silent --noproxy '*' --max-time 3 http://127.0.0.1:17640/api/v1/health |
    python3 -c 'import json,sys; d=json.load(sys.stdin); assert d.get("agentIndependentService") and d.get("brokerReady")'; then
    emit "AIWS_BOOT_SMOKE_FAIL: workbench-not-using-independent-agent"
    exit 1
fi
if ! /usr/local/bin/aiws-toolctl --list | grep -q '"workspace.tree"'; then
    emit "AIWS_BOOT_SMOKE_FAIL: mcp-unavailable"
    exit 1
fi
visible=0
for i in $(seq 1 45); do
    if runuser -u user -- env DISPLAY=:0 XAUTHORITY=/home/user/.Xauthority \
        xdotool search --onlyvisible --class Chromium >/dev/null 2>&1; then
        visible=1
        break
    fi
    sleep 2
done
if [ "$visible" -ne 1 ]; then
    emit "AIWS_BOOT_SMOKE_FAIL: chromium-shell-app-not-visible"
    exit 1
fi
# Verify real X11 focus routing and a synthetic Unicode desktop clipboard.
# Selenium separately tests React clicking and text input in the guest browser.
# Both depend on the window manager and the clipboard owner having settled, which takes noticeably longer on a
# software-emulated CPU, so the check is retried for up to ~60 s. It must still succeed: no retry is a pass by itself.
focus_ok=0
for i in $(seq 1 30); do
    if runuser -u user -- env DISPLAY=:0 XAUTHORITY=/home/user/.Xauthority \
        /bin/sh -c '
          pkill -x xclip 2>/dev/null
          window="$(xdotool search --onlyvisible --class Chromium | tail -n 1)" || exit 1
          test -n "$window" || exit 1
          xdotool windowactivate --sync "$window" || exit 1
          test "$(xdotool getactivewindow)" = "$window" || exit 1
          printf "AIWS-输入-clipboard" | xclip -selection clipboard -loops 1 || exit 1
          sleep 1
          test "$(xclip -selection clipboard -o)" = "AIWS-输入-clipboard"
        ' >/dev/null 2>&1; then
        focus_ok=1
        break
    fi
    sleep 2
done
if [ "$focus_ok" -ne 1 ]; then
    emit "AIWS_BOOT_SMOKE_FAIL: shell-x11-focus-or-clipboard"
    exit 1
fi
if ! runuser -u user -- env DISPLAY=:0 XAUTHORITY=/home/user/.Xauthority \
   python3 /usr/local/lib/aiws/aiws_gui_smoke.py; then
    emit "AIWS_BOOT_SMOKE_FAIL: workbench-gui-clicks-or-dag"
    exit 1
fi
# Verify the guest system is resilient to UI and durable Agent user-unit
# restarts, and task/audit evidence survives across both processes.
if ! runuser -u user -- env XDG_RUNTIME_DIR=/run/user/1000 \
    python3 /usr/local/lib/aiws/aiws_guest_lifecycle_smoke.py; then
    emit "AIWS_BOOT_SMOKE_FAIL: guest-agent-lifecycle-recovery"
    exit 1
fi
if [ -f /etc/aiws/guest-model-acceptance ]; then
    if ! runuser -u user -- env DISPLAY=:0 XDG_RUNTIME_DIR=/run/user/1000 \
        python3 /usr/local/lib/aiws/aiws_model_guest_smoke.py > /dev/ttyS0 2>&1; then
        emit "AIWS_BOOT_SMOKE_FAIL: real-offline-model-inference"
        exit 1
    fi
fi
emit "AIWS_BOOT_SMOKE_PASS: lightdm=active shell=native-panel chromium=app-window x11=focused clipboard=utf8 workbench=active tools=mcp gui=clicked"
exit 0
