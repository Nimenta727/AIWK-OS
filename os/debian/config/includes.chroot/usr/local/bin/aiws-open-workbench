#!/bin/sh
# XFCE autostart: activate the user service, then open the shared AIWS React UI.
set -eu
if [ "$(id -u)" -eq 0 ]; then exit 1; fi
# Provision ONLY checksum-verified root-owned model data from the guest ISO.
# Service stays disabled until the user explicitly enables it in AIWS.
if [ -f /usr/local/share/aiws/model-preload/manifest.json ] &&
   [ ! -f "$HOME/.local/share/aiws/models/registry.json" ]; then
  python3 /usr/local/lib/aiws/aiws_model_registry.py --import-bundled ||
    echo "Guest offline model preload refused; use deterministic Agent without model" >&2
fi
systemctl --user start aiws-workbench.service || exit 1
ready=0
for i in $(seq 1 45); do
    if curl --noproxy '*' --max-time 1 --fail --silent http://127.0.0.1:17640/api/v1/health >/dev/null; then
        ready=1
        break
    fi
    sleep 1
done
if [ "$ready" -ne 1 ]; then echo 'AIWS local guest service did not start' >&2; exit 1; fi
if command -v chromium >/dev/null 2>&1; then
    exec chromium --no-first-run --no-default-browser-check --disable-session-crashed-bubble --no-proxy-server --kiosk http://127.0.0.1:17640/
fi
if command -v firefox-esr >/dev/null 2>&1; then
    exec firefox-esr --new-window http://127.0.0.1:17640/
fi
echo 'No compatible browser installed' >&2
exit 1
