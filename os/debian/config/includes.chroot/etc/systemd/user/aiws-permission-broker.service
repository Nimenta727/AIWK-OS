[Unit]
Description=AIWS unprivileged guest-only independent permission policy broker
After=default.target
Before=aiws-agent.service

[Service]
Type=simple
ExecStart=/usr/local/bin/aiws-broker
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077
RuntimeDirectory=aiws-broker
RuntimeDirectoryMode=0700
MemoryMax=256M
CPUQuota=100%
TasksMax=64
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

[Install]
WantedBy=default.target
