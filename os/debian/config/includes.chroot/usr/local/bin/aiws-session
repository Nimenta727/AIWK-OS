#!/bin/sh
# AIWS Shell: the workbench IS the desktop. Only a bare window manager runs (no panel, no menu, no title bars);
# every system action (network, display, input method, power, files, apps) lives inside the workbench.
set -eu
if [ "$(id -u)" -eq 0 ]; then echo 'No root graphical AIWS session' >&2; exit 1; fi
export XDG_CURRENT_DESKTOP=AIWS
export DESKTOP_SESSION=aiws
export XDG_SESSION_DESKTOP=aiws
mkdir -p "$HOME/.local/share/aiws"
# Input method is optional at runtime; never prevent the desktop from booting.
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
if command -v fcitx5 >/dev/null 2>&1; then fcitx5 -d >/dev/null 2>&1 || true; fi
# A plain dark root window instead of the default X stipple, so nothing ever looks like a "desktop".
if command -v xsetroot >/dev/null 2>&1; then xsetroot -solid '#0f1115' >/dev/null 2>&1 || true; fi
openbox --config-file /usr/local/share/aiws/shell/openbox.xml &
wm=$!
trap 'kill "$wm" 2>/dev/null || true' EXIT INT TERM
sleep 1
if ! kill -0 "$wm" 2>/dev/null; then
  echo 'AIWS window manager unavailable' >&2
  exit 1
fi
while kill -0 "$wm" 2>/dev/null; do
  /usr/local/bin/aiws-open-workbench || true
  sleep 2
done
echo 'AIWS Shell lost its window manager' >&2
exit 1
